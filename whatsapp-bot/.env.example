# ---- Claude ----------------------------------------------------------------
# Get a key at https://platform.claude.com/ (Settings -> API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Model + effort. Effort trades speed/cost for depth: low | medium | high | xhigh | max
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=4096

# Who Claude is on WhatsApp. Edit freely.
BOT_NAME=Claude
SYSTEM_PROMPT=You are Claude, a helpful assistant chatting on WhatsApp for AHD Group. Keep replies concise and conversational (WhatsApp-sized). Use plain text: no markdown headers or tables; *bold* and _italics_ and - bullet lists are fine.

# ---- WhatsApp --------------------------------------------------------------
# Your own number(s) in international format, digits only, comma separated.
# Owners can run admin commands (!groups, !summary, !ai on/off ...) from anywhere.
# Messages you type from the linked phone itself always count as owner.
OWNER_NUMBERS=

# Reply to direct messages from anyone?  true | false
DM_ENABLED=true

# Default behaviour inside groups:
#   mention -> reply only when @mentioned, replied-to, or the message starts with a trigger word
#   always  -> reply to every group message (careful: noisy + costly)
#   off     -> never reply in groups (still keeps a memory of group messages for !summary)
GROUP_MODE=mention

# Trigger words that make Claude answer in a group even without an @mention.
# Comma separated, case-insensitive, matched at the start of the message.
TRIGGER_WORDS=!ai,claude,@claude,hey claude

# Only work in these groups (comma separated; either full group JID like
# 120363012345678901@g.us or a case-insensitive substring of the group name).
# Leave empty to allow every group the number is in.
ALLOWED_GROUPS=

# How many recent group messages Claude sees as context when it replies in a group.
GROUP_CONTEXT_MESSAGES=40

# How many recent messages to keep per group for !summary (rolling window).
GROUP_MEMORY_MESSAGES=300

# How many past turns (user+assistant) to remember per chat.
HISTORY_TURNS=30

# Where to keep the WhatsApp session and the bot's memory.
AUTH_DIR=./auth
DATA_DIR=./data

# pino log level for Baileys internals: silent | error | warn | info | debug
LOG_LEVEL=warn
